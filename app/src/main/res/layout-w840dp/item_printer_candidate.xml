<?xml version="1.0" encoding="utf-8"?>
<!-- Wide screens: address on the left, fixed-width buttons on the right, all on one line -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="16dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/candidateAddress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/candidateTestButton"
        style="@style/ActionButton.Outlined"
        android:layout_width="180dp"
        android:layout_marginEnd="12dp"
        android:text="@string/candidate_test" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/candidateUseButton"
        style="@style/ActionButton"
        android:layout_width="180dp"
        android:text="@string/candidate_use" />
</LinearLayout>
