<?xml version="1.0" encoding="utf-8"?>
<!-- Wide screens such as the Sunmi in landscape: status and activity on the left, actions on the right -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="40dp"
        android:paddingTop="40dp"
        android:paddingEnd="40dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="32dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <include layout="@layout/panel_status" />

            <include layout="@layout/panel_activity" />
        </LinearLayout>

        <!-- Fixed width keeps buttons a comfortable size instead of stretching across a large screen -->
        <LinearLayout
            android:layout_width="420dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/panel_controls" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
