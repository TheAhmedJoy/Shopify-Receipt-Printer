<?xml version="1.0" encoding="utf-8"?>
<!-- Shown only while someone needs to pick the kitchen printer from several devices -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/choosePrinterCard"
    style="@style/Card"
    android:visibility="gone"
    app:strokeColor="?attr/colorPrimary"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_choose_printer" />

        <TextView
            android:id="@+id/choosePrinterText"
            style="@style/Description" />

        <LinearLayout
            android:id="@+id/candidateList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
